{
  "name": "whisper-floating-widget",
  "version": "1.2.0",
  "description": "Floating Voice-to-Text widget powered by Whisper & Groq API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "sync": "node sync.js",
    "check-update": "node sync.js --check"
  },
  "build": {
    "appId": "com.whisper.floatingwidget",
    "productName": "WhisperWidget",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "signtoolOptions": {
        "certificateFile": "certs/arss-codesign.pfx",
        "certificatePassword": "arss123",
        "publisherName": "ARSS"
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Whisper Widget",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "Whisper Widget",
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!dist/**",
      "!scratch/**",
      "!*.log",
      "!config.json",
      "!voice-profile.json"
    ],
    "asarUnpack": [
      "piper/**/*",
      "injector.exe"
    ]
  },
  "keywords": [
    "whisper",
    "speech-to-text",
    "floating-widget",
    "dictation",
    "groq"
  ],
  "author": "ARSS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}
